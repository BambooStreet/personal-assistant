{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Personal Assistant",
  "version": "0.1.0",
  "identifier": "dev.ohmyhong.personalassistant",
  "build": {
    "beforeDevCommand": "npm -w apps/renderer run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm -w apps/renderer run build",
    "frontendDist": "../apps/renderer/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Personal Assistant",
        "width": 360,
        "height": 560,
        "minWidth": 360,
        "minHeight": 560,
        "maxWidth": 360,
        "maxHeight": 560,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
